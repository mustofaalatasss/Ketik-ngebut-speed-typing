# Salin menjadi /etc/ketikngebut/ketikngebut.env lalu isi nilainya.
# Berkas asli berisi secret: JANGAN diunggah ke GitHub. Izin berkas: chmod 600 (hanya root).

# Lokasi database SQLite (folder ini dibuat saat pemasangan).
ConnectionStrings__Default=Data Source=/var/lib/ketikngebut/ketikngebut.db

# Kunci tanda tangan JWT, minimal 32 karakter acak. Buat dengan:  openssl rand -base64 48
Jwt__SigningKey=GANTI_DENGAN_HASIL_openssl_rand

# Opsional: akun admin untuk mengelola teks lewat API. Kosongkan bila tidak perlu.
Seed__AdminEmail=
Seed__AdminPassword=
