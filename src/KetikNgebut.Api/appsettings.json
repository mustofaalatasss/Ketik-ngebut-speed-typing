{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Limits": {
    "MaxRequestBodyBytes": 524288
  },
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/ketikngebut.db"
  },
  "Jwt": {
    "Issuer": "KetikNgebut",
    "Audience": "KetikNgebut.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Typing": {
    "CharsPerWord": 5,
    "MaxErrorBuffer": 8,
    "TimeLimitMs": 180000
  },
  "ResultValidation": {
    "MaxWpm": 250,
    "MaxLogEntries": 5000,
    "DurationToleranceMs": 50,
    "RhythmMinKeystrokes": 20,
    "FastIntervalMs": 25,
    "MaxFastIntervalRatio": 0.3,
    "MinIntervalCoefficientOfVariation": 0.1
  },
  "Leaderboard": {
    "TimeZone": "Asia/Jakarta",
    "DefaultPageSize": 20,
    "MaxPageSize": 50
  },
  "Stats": {
    "HistorySize": 50
  },
  "RateLimit": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Results": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Players": { "PermitLimit": 5, "WindowSeconds": 3600 }
  },
  "Auth": {
    "Lockout": { "MaxFailedAttempts": 5, "LockoutMinutes": 5 }
  }
}
